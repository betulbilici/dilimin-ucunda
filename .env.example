# Google AI Studio'dan alınan Gemini API anahtarı (asla istemciye gönderilmez)
GEMINI_API_KEY=buraya_gemini_api_anahtarinizi_yazin

# Kullanılacak Gemini model adı (koda gömülmez, buradan okunur)
GEMINI_MODEL=gemini-2.5-flash

# İsteğe bağlı: Canlı frontend adresi (ör. GitHub Pages kök adresi)
# CORS_ORIGIN=https://betulbilici.github.io
